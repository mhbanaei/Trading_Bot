# --- real config and secrets (config.example.json is the committed one) ---
config.json
.env
.env.*
!.env.example
credentials*.json
web_auth.json
htpasswd
*.htpasswd
*.key
*.pem
*.p12

# --- runtime data: databases, logs, caches, dashboard screenshots ---
data/
logs/
screenshots/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
events*.jsonl

# --- private runtime databases (never in this repository) ---
# The bot writes these next to run.py or under data/; RTC/ only ever holds
# sanitized JSON/Markdown reports generated by sync_rtc.py.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
error.db
error.db-*
failed_trade.db
failed_trade.db-*
*.db.sync-tmp

# --- tooling ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/
.freebuff/
node_modules/
.DS_Store
Thumbs.db
